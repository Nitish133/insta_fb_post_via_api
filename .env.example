# Copy this file to .env and fill in real values.
# See README.md "Meta setup, step by step" for how to obtain each one.
# Never commit the real .env file.

# The Facebook Page ID of your throwaway test Page
FB_PAGE_ID=your_facebook_page_id_here

# A Page Access Token for that Page (long-lived, generated via Graph API
# Explorer -> exchanged for a long-lived token -> exchanged for a page token)
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# The Instagram Business Account ID linked to that same test Page
IG_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Graph API version to target
GRAPH_API_VERSION=v26.0